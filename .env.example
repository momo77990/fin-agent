# ── LLM 配置 ──
# 提示：登录到 Web UI 后可在「API 设置」页配置 LLM 接口（Base URL / Model / Key）
# 这些环境变量仅作为兜底/示例，不再是必填项。
# OPENAI_API_KEY=your-openai-or-compatible-key
# OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OPENAI_MODEL=qwen-plus

# ── 工具 API ──
# 同样可在 Web UI 中配置
# TAVILY_API_KEY=your-tavily-key

# ── 数据库 ──
# 注意：在 docker compose 中运行时，docker-compose.yml 会自动把 DB_HOST 覆盖为 mariadb（服务名）。
# 这里的 DB_HOST 仅用于「本机 Python 直接运行 streamlit」时连容器化的 MariaDB。
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finagent
DB_USER=finagent
DB_PASSWORD=finagentpass
DB_ROOT_PASSWORD=rootpass

# ── 应用端口（宿主机映射）──
APP_PORT=8501
